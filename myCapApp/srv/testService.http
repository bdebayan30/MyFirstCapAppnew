  "CURRENCY": "EUR"
}


###Get Product Data
http://localhost:4004/odata/v4/CatalogService/ProductSet

###Get single Product Data
http://localhost:4004/odata/v4/CatalogService/ProductSet/PROD0000000000000000000000000010

###Get Product Data with order data
http://localhost:4004/odata/v4/CatalogService/ProductSet/PROD0000000000000000000000000010?$expand=To_Items

###GET -all Purchase Order Data
http://localhost:4004/odata/v4/CatalogService/PurchaseOrderSet

###GET -single Purchase Order Data
http://localhost:4004/odata/v4/CatalogService/PurchaseOrderSet/PO000000000000000000000000000001?$expand=Items

###POST - Create New Purchase Order with Items
POST http://localhost:4004/odata/v4/CatalogService/PurchaseOrderSet
Content-Type: application/json

{
  "CURRENCY_code": "USD",
  "GROSS_AMOUNT": 500,
  "NET_AMOUNT": 500,
  "TAX_AMOUNT": 50,
  "NODE_KEY": "PO000000000000000000000000000011",
  "PO_ID": "PO-9001",
  "PARTNER_GUID_NODE_KEY": "BP000000000000000000000000000001",
  "LIFECYCLE_STATUS": "N",
  "OVERALL_STATUS": "P",
  "Items": [
    {
      "CURRENCY_code": "USD",
      "GROSS_AMOUNT": 250,
      "NET_AMOUNT": 250,
      "TAX_AMOUNT": 20,
      "NODE_KEY": "POI00000000000000000000000000021",
      "PARENT_KEY_NODE_KEY": "PO000000000000000000000000000011",
      "PO_ITEM_POS": 10,
      "PRODUCT_GUID_NODE_KEY": "PROD0000000000000000000000000001"
    },
    {
      "CURRENCY_code": "USD",
      "GROSS_AMOUNT": 250,
      "NET_AMOUNT": 250,
      "TAX_AMOUNT": 20,
      "NODE_KEY": "POI00000000000000000000000000022",
      "PARENT_KEY_NODE_KEY": "PO000000000000000000000000000011",
      "PO_ITEM_POS": 20,
      "PRODUCT_GUID_NODE_KEY": "PROD0000000000000000000000000003"
    }
  ]
}

